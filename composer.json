{
    "name": "cms-provenance/provenance-audit",
    "type": "typo3-cms-extension",
    "description": "Well-known audit endpoint listing signed documents, public keys and facts.",
    "license": "GPL-2.0-or-later",
    "homepage": "https://cms-provenance.org",
    "keywords": [
        "TYPO3",
        "extension",
        "provenance",
        "content-provenance",
        "json-ld"
    ],
    "support": {
        "issues": "https://github.com/dkd-dobberkau/typo3-provenance-audit/issues",
        "source": "https://github.com/dkd-dobberkau/typo3-provenance-audit"
    },
    "require": {
        "php": "^8.2",
        "typo3/cms-core": "^13.4 || ^14.0",
        "cms-provenance/provenance": "^0.1@dev"
    },
    "autoload": {
        "psr-4": {
            "CmsProvenance\\ProvenanceAudit\\": "Classes/"
        }
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "provenance_audit",
            "version": "0.0.0",
            "Package": {
                "providesPackages": {}
            }
        }
    }
}
